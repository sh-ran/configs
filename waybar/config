{
  "layer": "top",
  "position": "bottom",
  "modules-left": [
    "sway/workspaces",
    "clock"
  ],
  "modules-center": ["sway/window"],
  "modules-right": [
    "pulseaudio",
    "battery",
    "cpu",
    "memory",
    "tray"
  ],
  "sway/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "focused": "",
      "default": ""}
  },
  "tray": {
    "icon-size": 15,
    "spacing": 13
  },
  "clock": {
    "timezone": "Asia/Kolkata",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%d - %I:%M %p}"
  },
  "network": {
    "format-wifi": "󰤢 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip": false
  },
  "cpu": {
    "interval": 1,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },
  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G"
  },
  "sway/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]    
    },
    "on-click": "pavucontrol"
  }
}
